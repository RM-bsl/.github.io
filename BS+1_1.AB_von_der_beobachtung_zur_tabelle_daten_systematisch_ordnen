        const actions = document.getElementById('area-actions-' + i);

        card.classList.remove('pale-locked', 'ready-active', 'completed-area');
        badge.classList.remove('active', 'locked', 'done');

        if (state.areaCompleted[i]) {
          card.classList.add('completed-area');
