        text: 'Eine Zahlenmenge fasst Zahlen mit gleichen Eigenschaften zusammen. Sie sind wie ein Schachtelsystem aufgebaut: Jede neue Zahlenmenge schließt die bisherige vollständig ein und erweitert sie um neue Zahlenarten.'
      },
      wertetabelle: {
        title: 'Wertetabelle (Daten strukturieren)',
        text: 'Eine Wertetabelle ordnet unübersichtliche Einzeldaten in klaren Zeilen und Spalten. In der ersten Zeile steht die geordnete Ausgangsgröße (z. B. Uhrzeit), in der zweiten Zeile der zugehörige Mess- oder Beobachtungswert (z. B. Temperatur oder Verkaufsmenge).'
      },
      relation: {
        title: 'Relation (Mehrdeutige Beziehung)',
        text: 'Eine Relation ist jede allgemeine Zuordnung von Einzeldaten aus einer Ausgangsmenge X zu einer Zielmenge Y. Bei einer mehrdeutigen Relation sind einem einzigen Ausgangswert zwei oder mehr verschiedene Zielwerte zugeordnet.'
      },
      funktion: {
        title: 'Funktion (Eindeutige Zuordnung)',
        text: 'Eine Funktion ist eine eindeutige Zuordnung: Jedem Ausgangswert x wird genau ein einziger Zielwert y zugeordnet. Im Pfeildiagramm startet daher von jedem Ausgangswert x genau ein einziger Pfeil.'
      }
    };

    function openGlossary(key) {
      const entry = glossaryData[key];
      if (!entry) return;
      document.getElementById('modal-title').innerHTML = entry.title;
      document.getElementById('modal-content').innerHTML = entry.text;
      document.getElementById('glossary-modal').classList.add('open');
    }

    function closeGlossary() {
      document.getElementById('glossary-modal').classList.remove('open');
    }

    function handleBackdropClick(e) {
      if (e.target.id === 'glossary-modal') closeGlossary();
    }

    /* -----------------------------------------------------------------------
       NAVIGATION: HAUPTÜBERSICHT & UNTERSTRUKTUR
       ----------------------------------------------------------------------- */
    function updateHeaderPills() {
      const ovPill = document.getElementById('top-pill-overview');
      ovPill.classList.toggle('active', state.currentView === 'overview');

      const titles = ['1. Zahlenmengen', '2. Daten & Wertetabelle', '3. Zuordnungen & Beziehungen'];
      for (let i = 1; i <= 3; i++) {
        const p = document.getElementById('top-pill-' + i);
        p.classList.remove('active', 'completed');
        p.disabled = !state.areaUnlocked[i];

        if (state.currentView === 'area' && state.activeArea === i) {
          p.classList.add('active');
          p.innerHTML = (state.areaCompleted[i] ? '&#10003; ' : '') + titles[i - 1];
        } else if (state.areaCompleted[i]) {
          p.classList.add('completed');
          p.innerHTML = '&#10003; ' + titles[i - 1];
        } else {
          p.innerHTML = titles[i - 1];
        }
      }
    }

    function showOverview() {
      state.currentView = 'overview';
      saveState();
      document.getElementById('view-overview').style.display = 'block';
      document.getElementById('view-area-workspace').style.display = 'none';
      updateHeaderPills();
      renderOverviewCards();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderOverviewCards() {
      const abTasks = {
        1: 'Aufgabe 2a auf dem 1. AB',
