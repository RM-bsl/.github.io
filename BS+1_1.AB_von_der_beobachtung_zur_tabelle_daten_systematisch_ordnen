              <button class="btn-secondary" style="width: 100%; justify-content: center;" onclick="openAreaStepByStep(${i})">
                🔍 Einzelne Schritte nochmals ansehen
              </button>
            </div>
          `;
        } else if (state.areaUnlocked[i]) {
          card.classList.add('ready-active');
          badge.classList.add('active');
          badge.innerHTML = '📍 Jetzt an der Reihe: Lernbereich ' + i;
