            <button class="btn-primary" style="width: 100%; justify-content: center;" onclick="openArea(${i})">
              Lernbereich ${i} jetzt starten &rarr;
            </button>
          `;
        } else {
          card.classList.add('pale-locked');
          badge.classList.add('locked');
          badge.innerHTML = '🔒 Noch gesperrt (erst Lernbereich ' + (i - 1) + ' abschließen)';
          actions.innerHTML = `
            <button class="btn-primary" style="width: 100%; justify-content: center;" disabled>
              🔒 Wird nach Lernbereich ${i - 1} freigeschaltet
            </button>
          `;
        }
      }
    }

    function openArea(areaNum) {
      if (!state.areaUnlocked[areaNum]) return;
      state.currentView = 'area';
      state.activeArea = areaNum;
      saveState();
      document.getElementById('view-overview').style.display = 'none';
      document.getElementById('view-area-workspace').style.display = 'block';
      updateHeaderPills();
      renderActiveAreaWorkspace();
      window.scrollTo({ top: 0, behavior: 'smooth' });
