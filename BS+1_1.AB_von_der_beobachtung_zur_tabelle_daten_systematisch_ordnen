      area3FreetextSolved: false,
      area3FreetextValue: '',
      area3FreetextFeedback: '',
      relationMode: false
    };

    let state = loadState();

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return JSON.parse(JSON.stringify(defaultState));
        const parsed = JSON.parse(raw);
        return Object.assign(JSON.parse(JSON.stringify(defaultState)), parsed);
      } catch (e) {
        return JSON.parse(JSON.stringify(defaultState));
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {}
    }

    function resetAllProgress() {
      state = JSON.parse(JSON.stringify(defaultState));
      saveState();
      showOverview();
    }

    /* -----------------------------------------------------------------------
       HILFSFUNKTIONEN FÜR ZAHLENFORMATIERUNG (DEUTSCHES KOMMA & ANTI-LATEX)
       ----------------------------------------------------------------------- */
    function fmt(num) {
      if (num === null || num === undefined || Number.isNaN(num)) return '&ndash;';
      const rounded = Math.round(num * 100) / 100;
      if (Object.is(rounded, -0) || rounded === 0) return '0';
      const absStr = Math.abs(rounded).toString().replace('.', ',');
      return rounded < 0 ? '&minus;' + absStr : absStr;
    }

    function fmtCanvas(num) {
      const rounded = Math.round(num * 100) / 100;
      if (Object.is(rounded, -0) || rounded === 0) return '0';
      const absStr = Math.abs(rounded).toString().replace('.', ',');
      return rounded < 0 ? '−' + absStr : absStr;
    }

