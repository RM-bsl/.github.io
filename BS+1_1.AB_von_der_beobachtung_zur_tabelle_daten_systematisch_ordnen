    function openAreaInFullView(areaNum) {
      state.areaFullView[areaNum] = true;
      openArea(areaNum);
    }

    function openAreaStepByStep(areaNum) {
      state.areaFullView[areaNum] = false;
      openArea(areaNum);
    }

    function toggleFullView(areaNum) {
      state.areaFullView[areaNum] = !state.areaFullView[areaNum];
      saveState();
      renderActiveAreaWorkspace();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function completeAndGoToNextArea(completedAreaNum) {
      state.areaCompleted[completedAreaNum] = true;
      if (completedAreaNum < 3) {
        state.areaUnlocked[completedAreaNum + 1] = true;
      }
      saveState();
      showOverview();
    }

    /* -----------------------------------------------------------------------
       PÄDAGOGISCHE LERNÜBERSICHTEN (MERKBLÄTTER) & ABSCHLUSS-BANNER
       ----------------------------------------------------------------------- */
