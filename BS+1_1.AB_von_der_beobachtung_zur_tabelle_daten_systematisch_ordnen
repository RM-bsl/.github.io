    function drawNestingCanvas(maxStageIdx) {
      const canvas = document.getElementById('canvas-nesting');
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const cssW = 580, cssH = 350;
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      const ctx = canvas.getContext('2d');
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, cssW, cssH);

      const ellipses = [
        { idx: 4, cx: 290, cy: 118, rx: 262, ry: 102, label: 'ℝ (Reelle Zahlen: inkl. √2, π)', color: '#7C3AED', ex: '√2 ≈ 1,41   π ≈ 3,14', exX: 482, exY: 122 },
        { idx: 3, cx: 252, cy: 118, rx: 208, ry: 84,  label: 'ℚ (Rationale Zahlen / Brüche)', color: '#E65100', ex: '−3/4 = −0,75   1/3 = 0,33...', exX: 392, exY: 126 },
        { idx: 2, cx: 212, cy: 118, rx: 155, ry: 66,  label: 'ℤ (Ganze Zahlen)', color: '#1E8E3E', ex: '−250   −18   −1', exX: 305, exY: 128 },
        { idx: 1, cx: 178, cy: 118, rx: 106, ry: 48,  label: 'ℕ₀ (mit Null)', color: '#0284C7', ex: '0', exX: 245, exY: 128 },
        { idx: 0, cx: 148, cy: 118, rx: 64,  ry: 32,  label: 'ℕ (Zählzahlen)', color: '#1565C0', ex: '1, 12, 1.500', exX: 148, exY: 124 }
      ];

      ellipses.forEach(el => {
        const unlocked = el.idx <= maxStageIdx;
        const isCurrent = el.idx === maxStageIdx;

        ctx.beginPath();
        ctx.ellipse(el.cx, el.cy, el.rx, el.ry, 0, 0, Math.PI * 2);
        if (isCurrent) {
          ctx.fillStyle = el.color + '28';
          ctx.strokeStyle = el.color;
          ctx.lineWidth = 3;
        } else if (unlocked) {
          ctx.fillStyle = el.color + '14';
          ctx.strokeStyle = el.color;
          ctx.lineWidth = 1.8;
        } else {
          ctx.fillStyle = '#F8FAFC';
          ctx.strokeStyle = '#E2E8F0';
          ctx.lineWidth = 1;
        }
        ctx.fill();
        ctx.stroke();

        if (unlocked) {
          ctx.fillStyle = el.color;
          ctx.font = isCurrent ? 'bold 12px sans-serif' : '600 11px sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(el.label, el.cx, el.cy - el.ry + 15);

          ctx.fillStyle = '#0F172A';
          ctx.font = isCurrent ? 'bold 11.5px sans-serif' : '10.5px sans-serif';
          ctx.fillText(el.ex, el.exX, el.exY);
        }
      });

      const lineY = 292;
      const leftX = 45, rightX = 535;
      const centerX = (leftX + rightX) / 2;
      const scaleX = (rightX - leftX) / 8;

      ctx.fillStyle = '#F8FAFC';
      ctx.strokeStyle = '#E2E8F0';
      ctx.fillRect(20, 238, 540, 100);
      ctx.strokeRect(20, 238, 540, 100);

      ctx.fillStyle = '#334155';
      ctx.font = 'bold 11.5px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('Ausbreitung auf dem Zahlenstrahl bis Stufe ' + (maxStageIdx + 1) + ':', 32, 258);

      ctx.beginPath();
      ctx.moveTo(leftX, lineY);
      ctx.lineTo(rightX, lineY);
      ctx.strokeStyle = (maxStageIdx === 4) ? '#7C3AED' : '#94A3B8';
      ctx.lineWidth = (maxStageIdx === 4) ? 5 : 2;
      ctx.stroke();

      for (let i = -4; i <= 4; i++) {
        const px = centerX + i * scaleX;
        ctx.beginPath();
        ctx.moveTo(px, lineY - 5);
        ctx.lineTo(px, lineY + 5);
        ctx.strokeStyle = '#475569';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = '#475569';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(fmtCanvas(i), px, lineY + 20);
      }

      const pointsToPlot = [];
      if (maxStageIdx >= 0) pointsToPlot.push({ x: 1, l: '1', c: '#1565C0' }, { x: 2, l: '2', c: '#1565C0' }, { x: 3, l: '3', c: '#1565C0' });
      if (maxStageIdx >= 1) pointsToPlot.push({ x: 0, l: '0', c: '#0284C7' });
      if (maxStageIdx >= 2) pointsToPlot.push({ x: -1, l: '−1', c: '#1E8E3E' }, { x: -2, l: '−2', c: '#1E8E3E' }, { x: -3, l: '−3', c: '#1E8E3E' });
      if (maxStageIdx >= 3) pointsToPlot.push({ x: -0.75, l: '−3/4', c: '#E65100' }, { x: 0.33, l: '1/3', c: '#E65100' }, { x: 2.5, l: '2,5', c: '#E65100' });
      if (maxStageIdx >= 4) pointsToPlot.push({ x: 1.41, l: '√2', c: '#7C3AED' }, { x: 3.14, l: 'π', c: '#7C3AED' });

      pointsToPlot.forEach(pt => {
        const px = centerX + pt.x * scaleX;
        ctx.beginPath();
        ctx.arc(px, lineY, 5.5, 0, Math.PI * 2);
        ctx.fillStyle = pt.c;
        ctx.fill();
        ctx.fillStyle = pt.c;
        ctx.font = 'bold 10.5px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(pt.l, px, lineY - 10);
      });

      ctx.restore();
    }

