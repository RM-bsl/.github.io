              <input type="text" class="wt-input" id="raw-gap-${idx}" value="${savedVal}" placeholder="Wert?" oninput="checkArea2RawGaps()">
            </td>
          `;
        } else {
          tdHtml += `<td style="font-weight:700; color:#14532D; background:${col.isGap ? '#DCFCE7' : '#FFFFFF'};">${fmt(col.y)} ${ds.yUnit}</td>`;
        }
      });

      return `
        <div class="card-white">
          <span style="background:#EFF6FF; color:#1E40AF; font-weight:700; padding:4px 12px; border-radius:999px; font-size:0.85rem;">
            Unterbereich 2.2 von 2
          </span>
          <h3 style="font-size:1.25rem; margin: 10px 0 8px 0;">
            Wertetabelle ausfüllen: Übertrage die fehlenden Rohdaten aus der Notiz!
          </h3>

          <div class="raw-notes-paper">
            ${ds.rawChaosNote}
          </div>

          <div style="background:#F8FAFC; border:1px solid #CBD5E1; border-radius:12px; padding:16px;">
            <p style="font-size:0.92rem; color:#334155; margin-bottom:10px;">
              <strong>Deine Aufgabe:</strong> In der ersten Zeile sind die Zeitpunkte bereits geordnet. Suche die <strong>3 fehlenden Messwerte</strong> aus der gelben Notiz oben heraus und trage sie passend in die zweite Zeile ein!
            </p>

            <div class="wt-scroll-container">
              <table class="wt-table">
                <thead><tr>${thHtml}</tr></thead>
                <tbody><tr>${tdHtml}</tr></tbody>
              </table>
            </div>

            <div id="a2-s1-feedback" style="margin-top:12px;">
              ${solved ? `
                <div style="background:#DCFCE7; color:#14532D; border:1px solid #86EFAC; padding:12px 16px; border-radius:8px; font-weight:700;">
                  &#10003; Perfekt ausgefüllt! Du hast die Wertetabelle vollständig erstellt. Lies dir unten deine Lernübersicht durch und bearbeite anschließend <strong>Aufgabe 2b auf dem 1. AB</strong>!
                </div>
              ` : ''}
            </div>
          </div>
        </div>
      `;
    }

    function checkArea2RawGaps() {
      const ds = getActiveDataset();
      let allCorrect = true;
      ds.columns.forEach((col, idx) => {
        if (!col.isGap) return;
        const inp = document.getElementById('raw-gap-' + idx);
        if (!inp) return;
        state.area2FilledGaps[idx] = inp.value;
        const val = parseFloat(inp.value.trim().replace(',', '.').replace('−', '-'));
        if (!Number.isNaN(val) && Math.abs(val - col.y) < 0.05) {
          inp.style.borderColor = '#2E7D32';
          inp.style.background = '#DCFCE7';
        } else {
          allCorrect = false;
          inp.style.borderColor = '#3B82F6';
          inp.style.background = '#FFFFFF';
        }
      });

      saveState();

      if (allCorrect) {
        state.area2SubSolved[1] = true;
        state.areaCompleted[2] = true;
        state.areaUnlocked[3] = true;
        saveState();
        renderActiveAreaWorkspace();
      }
    }

    /* =======================================================================
       LERNBEREICH 3: EINZELDATEN ZUORDNEN (RELATION VS. FUNKTION)
       (REQ 5: Keine Ausgangsmatrizen, nur bearbeitete Wertetabelle;
        REQ 6: Beide Zuordnungsvarianten 1 und 2 erst auswählen, dann anzeigen;
        REQ 7: Bei 3.2 "Eineindeutige Funktion" entfernt;
        REQ 8: 3.3 entfernt;
        REQ 9: Nach 3.2 Aufforderung für Aufgabe 3!)
       ======================================================================= */
    function renderArea3() {
      document.getElementById('workspace-area-label').innerHTML = 'Lernbereich 3 von 3 (Einzeldaten zuordnen &ndash; 2 Stufen)';
      document.getElementById('workspace-area-title').innerHTML = '3. Einzeldaten einer Wertetabelle zuordnen: Relationen &amp; Funktionen';

      // REQ 8: 3.3 ist gelöscht -> Nur noch 3.1 und 3.2
      const subTitles = [
        '3.1 Bearbeitete Wertetabelle, Zuordnung 1 &amp; 2 &amp; Freitext',
        '3.2 Vertikalentest &amp; Beziehungsarten bestimmen'
      ];

      const pillsBox = document.getElementById('sub-pills-container');
      let pillsHtml = '';
      subTitles.forEach((t, idx) => {
        const isUnlocked = (idx === 0) || state.area3SubSolved[idx - 1] || state.areaCompleted[3];
        const isDone = state.area3SubSolved[idx];
        const isActive = (!state.areaFullView[3] && state.area3SubIndex === idx);
        let cls = 'step-pill';
        if (isActive) cls += ' active';
        else if (isDone) cls += ' completed';
        pillsHtml += `<button class="${cls}" ${!isUnlocked ? 'disabled' : ''} onclick="goToArea3Sub(${idx})">${isDone ? '&#10003; ' : ''}${t}</button>`;
      });
      pillsBox.innerHTML = pillsHtml;

      const content = document.getElementById('workspace-content');

      if (state.areaFullView[3]) {
        content.innerHTML = renderArea3Sub0Html() + renderArea3Sub1Html();
        setTimeout(() => {
          if (state.area3ActiveVar !== null) drawArea3ArrowCanvas();
          drawArea3ScannerCanvas(1.5);
        }, 30);
        return;
      }

      if (state.area3SubIndex === 0) {
        content.innerHTML = renderArea3Sub0Html();
        setTimeout(() => {
          if (state.area3ActiveVar !== null) drawArea3ArrowCanvas();
        }, 30);
      } else {
        content.innerHTML = renderArea3Sub1Html();
        setTimeout(() => drawArea3ScannerCanvas(1.5), 30);
      }
    }

    function goToArea3Sub(idx) {
      state.areaFullView[3] = false;
      state.area3SubIndex = idx;
      saveState();
      renderActiveAreaWorkspace();
    }

    // =========================================================================
    // UNTERBEREICH 3.1: BEARBEITETE WERTETABELLE (OHNE MATRIX!) +
    //                   ZUORDNUNGSVARIANTEN 1 & 2 ERST AUSWÄHLEN + FREITEXT-PRÜFER
    // =========================================================================
    function renderArea3Sub0Html() {
      const ds = getActiveDataset();
      const v1Viewed = state.area3ViewedVar1;
      const v2Viewed = state.area3ViewedVar2;
      const bothViewed = v1Viewed && v2Viewed;
      const activeVar = state.area3ActiveVar;
      const ftSolved = state.area3FreetextSolved;

      // Bearbeitete Wertetabelle aus Lernbereich 2 aufbauen (Req 5)
      let workedTh = `<th>1. Zeile (Ausgangswert x): ${ds.row1Label}</th>`;
      let workedTd = `<th>2. Zeile (Zugeordneter Wert y): ${ds.row2Label}</th>`;
      ds.columns.forEach(col => {
        workedTh += `<th>${col.xText}</th>`;
        workedTd += `<td style="font-weight:700; color:#14532D; background:#F0FDF4;">${fmt(col.y)} ${ds.yUnit}</td>`;
      });

      // Anzeige-Bereich für die ausgewählte Zuordnungsvariante (Req 6: Erst nach Auswahl anzeigen!)
      let variantDisplayHtml = '';
      if (activeVar === null) {
        variantDisplayHtml = `
          <div style="background:#F1F5F9; border:2px dashed #94A3B8; border-radius:12px; padding:24px; text-align:center; color:#475569; margin-top:12px;">
            👆 <strong>Noch keine Zuordnungsvariante ausgewählt:</strong><br>
            Klicke oben zuerst auf <strong>„Zuordnungsvariante 1“</strong> und danach auf <strong>„Zuordnungsvariante 2“</strong>, um die jeweilige Wertetabelle und ihr Pfeildiagramm sichtbar zu machen!
          </div>
        `;
      } else if (activeVar === 1) {
        variantDisplayHtml = `
          <div style="background:#F0FDF4; border:2px solid #86EFAC; border-radius:12px; padding:16px; margin-top:12px; animation: fadeIn 0.25s ease;">
            <div style="font-weight:800; color:#14532D; margin-bottom:8px;">
              ✅ Aktuell angezeigt: Zuordnungsvariante 1 (Uhrzeit x &rarr; Messwert y, wie in deiner bearbeiteten Wertetabelle)
            </div>
            <div class="wt-scroll-container">
              <table class="wt-table">
                <thead>
                  <tr><th>Ausgangswert x (Uhrzeit)</th><th>08:00 Uhr</th><th>12:00 Uhr</th><th>18:00 Uhr</th></tr>
                </thead>
                <tbody>
                  <tr><th>Zugeordneter Wert y (Temperatur)</th><td><strong>&minus;18 &deg;C</strong></td><td><strong>&minus;9 &deg;C</strong></td><td><strong>&minus;18 &deg;C</strong></td></tr>
                </tbody>
              </table>
            </div>
            <div class="canvas-wrapper" style="max-width:480px; margin:12px auto 0 auto;">
              <canvas id="canvas-area3-arrows" width="440" height="220"></canvas>
              <div style="font-size:0.8rem; color:#14532D; margin-top:4px; font-weight:600;">
                Pfeildiagramm zu Zuordnungsvariante 1: Beobachte, wie viele Pfeile von jedem Ausgangswert x links starten!
              </div>
            </div>
          </div>
        `;
      } else if (activeVar === 2) {
        variantDisplayHtml = `
          <div style="background:#FEF2F2; border:2px solid #FCA5A5; border-radius:12px; padding:16px; margin-top:12px; animation: fadeIn 0.25s ease;">
            <div style="font-weight:800; color:#991B1B; margin-bottom:8px;">
              ⚠️ Aktuell angezeigt: Zuordnungsvariante 2 (Umgekehrte Frage: Temperatur x &rarr; Uhrzeit y)
            </div>
            <div class="wt-scroll-container">
              <table class="wt-table">
                <thead>
                  <tr><th>Ausgangswert x (Temperatur)</th><th style="background:#FEE2E2; color:#991B1B;">&minus;18 &deg;C</th><th style="background:#FEE2E2; color:#991B1B;">&minus;18 &deg;C</th><th>&minus;9 &deg;C</th></tr>
                </thead>
                <tbody>
                  <tr><th>Zugeordneter Wert y (Uhrzeit)</th><td><strong>08:00 Uhr</strong></td><td><strong>18:00 Uhr</strong></td><td><strong>12:00 Uhr</strong></td></tr>
                </tbody>
              </table>
            </div>
            <div class="canvas-wrapper" style="max-width:480px; margin:12px auto 0 auto;">
              <canvas id="canvas-area3-arrows" width="440" height="220"></canvas>
              <div style="font-size:0.8rem; color:#991B1B; margin-top:4px; font-weight:600;">
                Pfeildiagramm zu Zuordnungsvariante 2: Beobachte, was beim Ausgangswert x = &minus;18 &deg;C passiert!
              </div>
            </div>
          </div>
        `;
      }

      return `
        <div class="card-white">
          <span style="background:#EFF6FF; color:#1E40AF; font-weight:700; padding:4px 12px; border-radius:999px; font-size:0.85rem;">
            Unterbereich 3.1 von 2
          </span>
          <h3 style="font-size:1.25rem; margin: 10px 0 8px 0;">
            Einzeldaten deiner bearbeiteten Wertetabelle zuordnen &amp; vergleichen
          </h3>

          <!-- REQ 5: KEINE AUSGANGSMATRIZEN, SONDERN DIE BEARBEITETE WERTETABELLE ANZEIGEN -->
          <div style="background:#F8FAFC; border:2px solid #CBD5E1; border-radius:12px; padding:16px; margin-bottom:18px;">
            <div style="font-weight:800; color:#0F172A; margin-bottom:6px;">
              📋 Deine fertig bearbeitete Wertetabelle aus Lernbereich 2 (${ds.title}):
            </div>
            <p style="font-size:0.88rem; color:#334155; margin-bottom:8px;">
              Jede Spalte deiner Tabelle bildet ein festes Datenpaar <strong>(x | y)</strong> und ordnet einem Ausgangswert <strong>x</strong> (1. Zeile) einen Messwert <strong>y</strong> (2. Zeile) zu:
            </p>
            <div class="wt-scroll-container">
              <table class="wt-table">
                <thead><tr>${workedTh}</tr></thead>
                <tbody><tr>${workedTd}</tr></tbody>
              </table>
            </div>
          </div>

          <!-- REQ 6: BEIDE ZUORDNUNGSVARIANTEN 1 UND 2 ZUNÄCHST AUSWÄHLEN UND ERST DANN ANZEIGEN -->
          <div style="background:#FFFFFF; border:2px solid #BFDBFE; border-radius:12px; padding:16px; margin-bottom:18px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:10px;">
              <strong style="color:#1E3A8A; font-size:1.02rem;">
                🔎 Schritt 1: Wähle nacheinander beide Zuordnungsvarianten (1 und 2) aus, um sie aufzudecken:
              </strong>
              <span style="font-size:0.84rem; font-weight:700; color:${bothViewed ? '#14532D' : '#475569'};">
                Aufgedeckt: ${(v1Viewed ? 1 : 0) + (v2Viewed ? 1 : 0)} von 2 Varianten ${bothViewed ? '&#10003;' : ''}
              </span>
            </div>

            <div style="display:flex; gap:12px; flex-wrap:wrap;">
              <button
                class="btn-secondary ${activeVar === 1 ? 'selected-variant' : ''}"
                style="flex:1; min-width:240px; justify-content:center; padding:12px;"
                onclick="selectArea3Variant(1)"
              >
                ${v1Viewed ? '&#10003; ' : '👁️ '}Zuordnungsvariante 1 auswählen (Eindeutig)
              </button>

              <button
                class="btn-secondary ${activeVar === 2 ? 'selected-variant' : ''}"
                style="flex:1; min-width:240px; justify-content:center; padding:12px;"
                onclick="selectArea3Variant(2)"
              >
                ${v2Viewed ? '&#10003; ' : '👁️ '}Zuordnungsvariante 2 auswählen (Mehrdeutig)
              </button>
            </div>

            ${variantDisplayHtml}
          </div>

          <!-- SCHRITT 2: FREITEXTAUFGABE MIT INTELLIGENTEM PRÜFER (Wird freigeschaltet, sobald beide Varianten ausgewählt wurden!) -->
          ${bothViewed ? `
            <div style="background:#F8FAFC; border:2px solid #3B82F6; border-radius:12px; padding:16px; animation: fadeIn 0.3s ease;">
              <div style="font-weight:800; color:#1E3A8A; margin-bottom:6px;">
                ✍️ Schritt 2: Freitext-Beobachtung mit intelligentem Prüfer
              </div>
              <p style="font-size:0.9rem; color:#334155; margin-bottom:6px;">
                Du hast nun beide Zuordnungsvarianten aufgedeckt. <strong>Fasse deine Beobachtung in eigenen Worten zusammen:</strong> Worin unterscheiden sich <strong>Zuordnungsvariante 1</strong> und <strong>Zuordnungsvariante 2</strong>, wenn du darauf achtest, wie viele Pfeile (bzw. Zielwerte y) von einem einzigen Ausgangswert x starten?
              </p>

              <textarea
                id="area3-freetext-input"
                class="freetext-area"
                placeholder="Schreibe hier deine Beobachtung auf (z. B.: Bei Zuordnung 1 startet von jedem Ausgangswert x genau ein Pfeil, während bei Zuordnung 2 von einem Ausgangswert x zwei Pfeile zu verschiedenen y-Werten starten...)"
                oninput="saveFreetextDraft(this.value)"
              >${state.area3FreetextValue || ''}</textarea>

              <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-top:10px;">
                <button class="btn-secondary" onclick="insertFreetextHint()">
                  💡 Denkimpuls / Satzstarter anzeigen
                </button>
                <button class="btn-primary" onclick="evaluateArea3Freetext()">
                  🤖 Beobachtung vom Prüfer auswerten lassen
                </button>
              </div>

              <div id="a3-freetext-feedback" style="margin-top:12px;">
                ${state.area3FreetextFeedback || ''}
              </div>
            </div>
          ` : `
            <div style="background:#F1F5F9; border:1px dashed #94A3B8; border-radius:10px; padding:14px; text-align:center; color:#475569;">
              🔒 <strong>Die Freitextaufgabe wird angezeigt, sobald du oben beide Zuordnungsvarianten (1 und 2) mindestens einmal angeklickt und verglichen hast!</strong>
            </div>
          `}

          <!-- FREIGESCHALTETE ERKLÄRUNG NACH KORREKTEM FREITEXT -->
          ${(bothViewed && ftSolved) ? `
            <div style="margin-top:18px; border-top:2px solid #2E7D32; padding-top:16px; animation: fadeIn 0.3s ease;">
              <div class="info-card-yellow">
                🔓 <strong>Freigeschaltete Gesamterklärung zu 3.1 (Relation vs. Funktion):</strong><br>
                &bull; <strong>Zuordnungsvariante 1 ist eine eindeutige <span class="math-term-clickable" onclick="openGlossary('funktion')">Funktion</span>:</strong> Jedem Ausgangswert <strong>x</strong> (jeder Uhrzeit) wird <strong>genau ein einziger</strong> Zielwert <strong>y</strong> (genau eine Temperatur) zugeordnet. Von jedem x startet im Pfeildiagramm <strong>genau 1 Pfeil</strong>. (Dass um 08:00 Uhr und um 18:00 Uhr dieselbe Temperatur von &minus;18 &deg;C herrscht, ist bei einer Funktion völlig erlaubt!).<br>
                &bull; <strong>Zuordnungsvariante 2 ist nur eine mehrdeutige <span class="math-term-clickable" onclick="openGlossary('relation')">Relation</span> (Keine Funktion):</strong> Dem einen Ausgangswert <strong>x = &minus;18 &deg;C</strong> sind gleichzeitig <strong>zwei verschiedene Uhrzeiten</strong> (08:00 Uhr und 18:00 Uhr) zugeordnet. Da von x = &minus;18 &deg;C <strong>zwei Pfeile</strong> starten, ist die Zuordnung nicht eindeutig!
              </div>
              <div style="text-align:right;">
                <button class="btn-primary" onclick="goToArea3Sub(1)">
                  Weiter zu 3.2: Vertikalentest &amp; Beziehungsarten bestimmen &rarr;
                </button>
              </div>
            </div>
          ` : ''}
        </div>
      `;
    }

    function selectArea3Variant(varNum) {
      state.area3ActiveVar = varNum;
      if (varNum === 1) {
        state.area3ViewedVar1 = true;
        state.relationMode = false;
      } else if (varNum === 2) {
        state.area3ViewedVar2 = true;
        state.relationMode = true;
      }
      saveState();
      renderActiveAreaWorkspace();
    }

    function saveFreetextDraft(val) {
      state.area3FreetextValue = val;
      saveState();
    }

    function insertFreetextHint() {
      const fb = document.getElementById('a3-freetext-feedback');
      if (fb) {
        fb.innerHTML = `
          <div style="background:#FEF9E7; border:1px solid #FDE68A; color:#000000; padding:10px 12px; border-radius:8px; font-size:0.86rem;">
            💡 <strong>Formulierungshilfe:</strong> Beschreibe, dass bei Variante 1 von jedem Ausgangswert x <em>„genau ein Pfeil / genau ein Wert y“</em> ausgeht (eindeutig), während bei Variante 2 von einem x-Wert <em>„zwei / mehrere Pfeile bzw. Zielwerte“</em> ausgehen (mehrdeutig).
          </div>
        `;
      }
    }

    function evaluateArea3Freetext() {
      const inp = document.getElementById('area3-freetext-input');
      if (!inp) return;
      const rawText = inp.value.trim();
      state.area3FreetextValue = rawText;
      const text = rawText.toLowerCase();
      const wordCount = rawText.split(/\s+/).filter(Boolean).length;

      const hasInputConcept = /(eingang|ausgang|x|wert|uhrzeit|temperatur|links|start|jedem|einem|variante|zuordnung)/.test(text);
      const hasUniqueConcept = /(genau ein|nur ein|ein einziger|einen pfeil|1 pfeil|ein pfeil|eindeutig|ein y|ein ziel|einmal)/.test(text);
      const hasMultiConcept = /(zwei|2|mehrere|doppelt|mehrdeutig|verschiedene|mehr als ein|beide)/.test(text);

      if (wordCount < 6) {
        state.area3FreetextFeedback = `
          <div class="warn-card-red">
            🤖 <strong>Prüfer-Rückmeldung:</strong> Deine Antwort ist noch etwas zu kurz (${wordCount} Wörter). Bitte formuliere mindestens einen vollständigen Satz über die Anzahl der Pfeile bzw. Zielwerte y pro Ausgangswert x!
          </div>
        `;
      } else if (hasInputConcept && (hasUniqueConcept || hasMultiConcept)) {
        state.area3FreetextSolved = true;
        state.area3SubSolved[0] = true;

        const detectedDetails = [];
        if (hasUniqueConcept) detectedDetails.push('die <strong>Eindeutigkeit (genau 1 Pfeil / 1 Zielwert pro x)</strong> in Variante 1');
        if (hasMultiConcept) detectedDetails.push('die <strong>Mehrdeutigkeit (2 Pfeile / 2 Zielwerte bei einem x)</strong> in Variante 2');

        state.area3FreetextFeedback = `
          <div style="background:#DCFCE7; color:#14532D; border:1px solid #86EFAC; padding:12px 14px; border-radius:8px; font-size:0.9rem;">
            🤖 <strong>&#10003; Intelligenter Prüfer &ndash; Beobachtung vollkommen richtig!</strong><br>
            Du hast ${detectedDetails.join(' sowie ')} treffend beschrieben. Die Gesamterklärung und Schritt 3.2 sind jetzt freigeschaltet!
          </div>
        `;
      } else {
        state.area3FreetextFeedback = `
          <div class="warn-card-red">
            🤖 <strong>Prüfer-Hinweis:</strong> Nenne in deiner Antwort noch konkret die <strong>Anzahl der Pfeile bzw. zugeordneten Werte</strong>: Wie viele Pfeile starten in Variante 1 pro Ausgangswert x (<em>genau einer</em>) und wie viele starten bei &minus;18 &deg;C in Variante 2 (<em>zwei Pfeile</em>)?
          </div>
        `;
      }

      saveState();
      renderActiveAreaWorkspace();
    }

    function drawArea3ArrowCanvas() {
      const canvas = document.getElementById('canvas-area3-arrows');
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const cssW = 440, cssH = 220;
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      const ctx = canvas.getContext('2d');
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, cssW, cssH);

      const leftX = 105, rightX = 335;
      ctx.fillStyle = '#EFF6FF'; ctx.strokeStyle = '#3B82F6'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.ellipse(leftX, 118, 62, 78, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

      ctx.fillStyle = '#F0FDF4'; ctx.strokeStyle = '#22C55E';
      ctx.beginPath(); ctx.ellipse(rightX, 118, 62, 78, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

      ctx.fillStyle = '#1E3A8A'; ctx.font = 'bold 12px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('Ausgangsmenge X', leftX, 24);
      ctx.fillStyle = '#166534';
      ctx.fillText('Zielmenge Y', rightX, 24);

      if (state.area3ActiveVar === 1) {
        // Variante 1: Uhrzeit -> Temperatur (Eindeutig)
        const xNodes = [
          { val: '08:00 Uhr', y: 74 },
          { val: '12:00 Uhr', y: 118 },
          { val: '18:00 Uhr', y: 162 }
        ];
        const yNodes = [
          { val: '−18 °C', y: 92 },
          { val: '−9 °C',  y: 146 }
        ];

        drawArrow(ctx, leftX + 36, 74,  rightX - 36, 92,  '#1565C0');
        drawArrow(ctx, leftX + 36, 118, rightX - 36, 146, '#1565C0');
        drawArrow(ctx, leftX + 36, 162, rightX - 36, 92,  '#1565C0');

        xNodes.forEach(n => {
          ctx.fillStyle = '#0F172A'; ctx.font = 'bold 11.5px sans-serif';
          ctx.fillText(n.val, leftX, n.y + 4);
        });
        yNodes.forEach(n => {
          ctx.fillStyle = '#0F172A'; ctx.font = 'bold 11.5px sans-serif';
          ctx.fillText(n.val, rightX, n.y + 4);
        });
      } else {
        // Variante 2: Temperatur -> Uhrzeit (Mehrdeutig: von -18 °C starten 2 Pfeile!)
        const xNodes = [
          { val: '−18 °C', y: 92 },
          { val: '−9 °C',  y: 146 }
        ];
        const yNodes = [
          { val: '08:00 Uhr', y: 74 },
          { val: '12:00 Uhr', y: 118 },
          { val: '18:00 Uhr', y: 162 }
        ];

        drawArrow(ctx, leftX + 36, 92,  rightX - 36, 74,  '#DC2626');
        drawArrow(ctx, leftX + 36, 92,  rightX - 36, 162, '#DC2626');
        drawArrow(ctx, leftX + 36, 146, rightX - 36, 118, '#1565C0');

        xNodes.forEach(n => {
          ctx.fillStyle = n.val === '−18 °C' ? '#991B1B' : '#0F172A';
          ctx.font = 'bold 11.5px sans-serif';
          ctx.fillText(n.val, leftX, n.y + 4);
        });
        yNodes.forEach(n => {
          ctx.fillStyle = '#0F172A'; ctx.font = 'bold 11.5px sans-serif';
          ctx.fillText(n.val, rightX, n.y + 4);
        });
      }

      ctx.restore();
    }

    function drawArrow(ctx, x1, y1, x2, y2, color) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
      const angle = Math.atan2(y2 - y1, x2 - x1);
      ctx.beginPath();
      ctx.moveTo(x2, y2);
      ctx.lineTo(x2 - 8 * Math.cos(angle - 0.35), y2 - 8 * Math.sin(angle - 0.35));
      ctx.lineTo(x2 - 8 * Math.cos(angle + 0.35), y2 - 8 * Math.sin(angle + 0.35));
      ctx.closePath();
      ctx.fillStyle = color;
      ctx.fill();
    }

    // =========================================================================
    // UNTERBEREICH 3.2: BEZIEHUNGSARTEN (OHNE EINEINDEUTIGE FUNKTION - REQ 7)
    //                   & VERTIKALENTEST -> ABSCHLUSS FÜR AUFGABE 3 (REQ 8 & 9)
    // =========================================================================
    function renderArea3Sub1Html() {
      const solved = state.area3SubSolved[1];
      return `
        <div class="card-white">
          <span style="background:#EFF6FF; color:#1E40AF; font-weight:700; padding:4px 12px; border-radius:999px; font-size:0.85rem;">
            Unterbereich 3.2 von 2
          </span>
          <h3 style="font-size:1.25rem; margin: 10px 0 8px 0;">
            Beziehungsarten der Einzeldaten bestimmen &amp; der Vertikalentest
          </h3>

          <!-- REQ 7: "2. Eineindeutige Funktion (Umkehrbar)" entfernt -> Fokus auf die beiden Kern-Beziehungsarten -->
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:14px; margin: 14px 0;">
            <div style="background:#F0FDF4; border:2px solid #86EFAC; border-radius:12px; padding:16px;">
              <strong style="color:#14532D; font-size:1.02rem;">1. Eindeutige Zuordnung (<span class="math-term-clickable" onclick="openGlossary('funktion')">Funktion</span>):</strong><br>
              <span style="font-size:0.9rem; color:#1E293B; display:block; margin-top:6px;">
                Jedem Ausgangswert <strong>x</strong> ist <strong>genau ein einziger</strong> Zielwert <strong>y</strong> zugeordnet.<br>
                &bull; <em>In der Wertetabelle:</em> Zu keinem x-Wert gibt es zwei verschiedene y-Werte.<br>
                &bull; <em>Im Diagramm:</em> Über jedem x-Wert liegt <strong>höchstens ein Punkt</strong>.
              </span>
            </div>

            <div style="background:#FEF2F2; border:2px solid #FCA5A5; border-radius:12px; padding:16px;">
              <strong style="color:#991B1B; font-size:1.02rem;">2. Mehrdeutige <span class="math-term-clickable" onclick="openGlossary('relation')">Relation</span> (Keine Funktion):</strong><br>
              <span style="font-size:0.9rem; color:#1E293B; display:block; margin-top:6px;">
                Mindestens einem Ausgangswert <strong>x</strong> sind <strong>zwei oder mehr verschiedene</strong> Zielwerte <strong>y</strong> zugeordnet.<br>
                &bull; <em>In der Wertetabelle:</em> Ein x-Wert taucht mit verschiedenen y-Werten auf.<br>
                &bull; <em>Im Diagramm:</em> Mindestens <strong>zwei Punkte liegen exakt senkrecht übereinander</strong>!
              </span>
            </div>
          </div>

          <div class="two-col-grid" style="margin-top:16px;">
            <div class="canvas-wrapper">
              <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px; margin-bottom:8px;">
                <button class="btn-secondary" onclick="setArea3ScannerMode(false)">Datenpunkte: Variante 1 (Funktion)</button>
                <button class="btn-secondary" style="color:#991B1B; border-color:#FCA5A5; background:#FEF2F2;" onclick="setArea3ScannerMode(true)">Datenpunkte: Variante 2 (Relation)</button>
                <button class="btn-primary" style="padding:7px 12px; font-size:0.84rem;" onclick="runArea3VerticalScan()">▶ Vertikalentest-Scanner</button>
              </div>
              <canvas id="canvas-area3-scanner" width="440" height="250"></canvas>
            </div>

            <div style="background:#F8FAFC; border:1px solid #CBD5E1; border-radius:12px; padding:16px;">
              <h4 style="color:#1E3A8A; margin-bottom:8px;">🔍 So prüfst du Einzeldaten im Diagramm (Vertikalentest):</h4>
              <p style="font-size:0.9rem; color:#334155; margin-bottom:14px;">
                Fahre mit einer senkrechten Prüflinie von links nach rechts über die eingetragenen Datenpunkte:<br>
                &bull; Trifft die Senkrechte bei jedem x-Wert <strong>höchstens einen Punkt</strong> &rarr; <strong>Eindeutige Funktion!</strong><br>
                &bull; Trifft die Senkrechte bei einem x-Wert <strong>zwei Punkte senkrecht übereinander</strong> &rarr; <strong>Mehrdeutige Relation (Keine Funktion)!</strong>
              </p>

              ${!solved ? `
                <button class="btn-success" style="width:100%; justify-content:center;" onclick="solveArea3Sub1()">
                  &#10003; Lernbereich 3 abschließen &amp; Lernübersicht öffnen
                </button>
              ` : `
                <div style="background:#DCFCE7; color:#14532D; border:1px solid #86EFAC; padding:12px 14px; border-radius:8px; font-weight:700;">
                  &#10003; Lernbereich 3 erfolgreich abgeschlossen! Lies dir unten deine Lernübersicht durch und bearbeite jetzt <strong>Aufgabe 3 auf dem 1. AB</strong>!
                </div>
              `}
            </div>
          </div>
        </div>
      `;
    }

    function setArea3ScannerMode(isRel) {
      state.relationMode = isRel;
      saveState();
      drawArea3ScannerCanvas(1.5);
    }

    let area3ScanAnim = null;
    function runArea3VerticalScan() {
      if (area3ScanAnim) cancelAnimationFrame(area3ScanAnim);
      let scanX = 0.5;
      function step() {
        scanX += 0.03;
        drawArea3ScannerCanvas(scanX);
        if (scanX < 3.5) {
          area3ScanAnim = requestAnimationFrame(step);
        }
      }
      step();
    }

    function drawArea3ScannerCanvas(scanX) {
      const canvas = document.getElementById('canvas-area3-scanner');
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const cssW = 440, cssH = 250;
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      const ctx = canvas.getContext('2d');
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, cssW, cssH);

      const padL = 62, padR = 30, padT = 32, padB = 36;
      const plotW = cssW - padL - padR;
      const plotH = cssH - padT - padB;

      const toPxX = x => padL + ((x - 0.5) / 3) * plotW;
      const toPxY = y => padT + plotH - (y / 35) * plotH;

      // Achsen
      ctx.strokeStyle = '#64748B'; ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + plotH); ctx.lineTo(cssW - padR, padT + plotH);
      ctx.stroke();

      if (!state.relationMode) {
        const xLabels = ['08:00', '12:00', '18:00'];
        [1, 2, 3].forEach((xv, i) => {
          ctx.fillStyle = '#334155'; ctx.font = 'bold 11px sans-serif'; ctx.textAlign = 'center';
          ctx.fillText(xLabels[i], toPxX(xv), cssH - 12);
        });
        ctx.fillStyle = '#334155'; ctx.font = '11px sans-serif'; ctx.textAlign = 'right';
        ctx.fillText('−18 °C', padL - 6, toPxY(10) + 4);
        ctx.fillText('−9 °C',  padL - 6, toPxY(25) + 4);
      } else {
        const xLabels = ['−18 °C', '−9 °C', '0 °C'];
        [1, 2, 3].forEach((xv, i) => {
          ctx.fillStyle = '#334155'; ctx.font = 'bold 11px sans-serif'; ctx.textAlign = 'center';
          ctx.fillText(xLabels[i], toPxX(xv), cssH - 12);
        });
        ctx.fillStyle = '#334155'; ctx.font = '11px sans-serif'; ctx.textAlign = 'right';
        ctx.fillText('08:00', padL - 6, toPxY(10) + 4);
        ctx.fillText('12:00', padL - 6, toPxY(20) + 4);
        ctx.fillText('18:00', padL - 6, toPxY(30) + 4);
      }

      const pts = !state.relationMode
        ? [{ x: 1, y: 10 }, { x: 2, y: 25 }, { x: 3, y: 10 }]
        : [{ x: 1, y: 10 }, { x: 1, y: 30 }, { x: 2, y: 20 }];

      pts.forEach(p => {
        ctx.beginPath();
        ctx.arc(toPxX(p.x), toPxY(p.y), 7, 0, Math.PI * 2);
        ctx.fillStyle = !state.relationMode ? '#1565C0' : '#DC2626';
        ctx.fill();
        ctx.strokeStyle = '#FFFFFF'; ctx.lineWidth = 2; ctx.stroke();
      });

      const sx = toPxX(scanX);
      ctx.strokeStyle = !state.relationMode ? '#16A34A' : '#DC2626';
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(sx, padT); ctx.lineTo(sx, padT + plotH); ctx.stroke();

      ctx.fillStyle = !state.relationMode ? '#14532D' : '#991B1B';
      ctx.font = 'bold 11.5px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(
        !state.relationMode
          ? 'Höchstens 1 Punkt pro Senkrechte -> Eindeutige Funktion!'
          : 'Bei −18 °C liegen 2 Punkte übereinander -> Mehrdeutige Relation!',
        padL + 4, 20
      );

      ctx.restore();
    }

    function solveArea3Sub1() {
      state.area3SubSolved[1] = true;
      state.areaCompleted[3] = true;
      saveState();
      renderActiveAreaWorkspace();
    }

    /* -----------------------------------------------------------------------
       INITIALISIERUNG BEIM SEITENSTART
       ----------------------------------------------------------------------- */
    window.addEventListener('DOMContentLoaded', () => {
      if (state.currentView === 'area') {
        openArea(state.activeArea);
      } else {
        showOverview();
      }
    });

    window.addEventListener('resize', () => {
      if (state.currentView === 'area') {
        if (state.activeArea === 1) {
          const idx = state.areaFullView[1] ? 4 : state.area1SubIndex;
          if (state.area1SubSolved[idx] || state.areaFullView[1]) drawNestingCanvas(idx);
        } else if (state.activeArea === 3) {
          if (state.area3ActiveVar !== null) drawArea3ArrowCanvas();
          drawArea3ScannerCanvas(1.5);
        }
      }
    });
  </script>
</body>
</html>
