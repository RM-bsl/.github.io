      area1PickedExamples: { 0: [], 1: [], 2: [], 3: [], 4: [] },
      area1SymbolStep: { 0: 0, 1: 0, 2: 0, 3: 0, 4: 0 },

      // Lernbereich 2: Reine Praxisdaten in Wertetabellen strukturieren (2 Unterstufen: 0=2.1, 1=2.2; 2.3 gelöscht!)
