          isDistractor: true,
          distractorReason: `Typische Fehlvorstellung: Zähler und Nenner im Differenzenquotienten sind vertauscht und <span class="math-eq"><span class="math-var">x</span><sub>1</sub><span class="math-op">=</span><span class="math-var">x</span><sub>2</sub></span> beschreibt eine senkrechte Gerade (keine Funktion).`,
          html: `Steigung über <span class="math-eq"><span class="math-var">m</span><span class="math-op">=</span><span class="math-frac"><span class="num"><span class="math-var">x</span><sub>2</sub><span class="math-op">&minus;</span><span class="math-var">x</span><sub>1</sub></span><span class="den"><span class="math-var">y</span><sub>2</sub><span class="math-op">&minus;</span><span class="math-var">y</span><sub>1</sub></span></span></span> berechnen; für <span class="math-eq"><span class="math-var">x</span><sub>1</sub><span class="math-op">=</span><span class="math-var">x</span><sub>2</sub></span> entsteht eine waagerechte Funktion mit <span class="math-eq"><span class="math-var">m</span><span class="math-op">=</span>0</span>.`
        }
      ];

      const CARD_MAP = Object.fromEntries(CARDS.map(c => [c.id, c]));
      const SLOT_MAP = Object.fromEntries(SLOTS.map(s => [s.id, s]));

      /* =========================================================
         2. SPIELZUSTAND
         ========================================================= */
      const state = {
        mode: 'standard',     // 'standard' | 'profi'
        phase: 'playing',     // 'playing' | 'error-modal' | 'hint-flash' | 'review-success'
        deck: [],             // Array von cardIds (deck[0] = oberste Karte)
        placements: {},       // { slotId: cardId | null }
        attempts: 0,          // Anzahl fehlgeschlagener Pruefungen
        soundEnabled: false,  // Standardmaessig stumm fuer den Unterricht
        teacherMode: false,
        hintTimerId: null
      };

      /* =========================================================
         3. DOM-REFERENZEN
         ========================================================= */
      const els = {
        modeStandardBtn: document.getElementById('modeStandardBtn'),
        modeProfiBtn: document.getElementById('modeProfiBtn'),
        soundToggleBtn: document.getElementById('soundToggleBtn'),
        soundIcon: document.getElementById('soundIcon'),
        soundLabel: document.getElementById('soundLabel'),
        teacherBtn: document.getElementById('teacherBtn'),
        teacherBtnLabel: document.getElementById('teacherBtnLabel'),
        teacherBar: document.getElementById('teacherBar'),
        showSolutionModalBtn: document.getElementById('showSolutionModalBtn'),
        autoFillBtn: document.getElementById('autoFillBtn'),
        exitTeacherBtn: document.getElementById('exitTeacherBtn'),
        resetBtn: document.getElementById('resetBtn'),

        openZoomBtn: document.getElementById('openZoomBtn'),
        visualStageTrigger: document.getElementById('visualStageTrigger'),
        templateSvg: document.getElementById('templateSvg'),
        zoomModal: document.getElementById('zoomModal'),
        zoomCanvasInner: document.getElementById('zoomCanvasInner'),
        closeZoomBtn: document.getElementById('closeZoomBtn'),

        hintCountdownBar: document.getElementById('hintCountdownBar'),
        hintCountdownPill: document.getElementById('hintCountdownPill'),
        slotEls: Array.from(document.querySelectorAll('.drop-slot')),
        slotMeasurer: document.getElementById('slotMeasurer'),
        transferCard: document.getElementById('transferCard'),

        deckCounterPill: document.getElementById('deckCounterPill'),
        profiNotice: document.getElementById('profiNotice'),
        progressLabel: document.getElementById('progressLabel'),
        progressRatio: document.getElementById('progressRatio'),
        progressFill: document.getElementById('progressFill'),
        stackShadow2: document.getElementById('stackShadow2'),
        stackShadow3: document.getElementById('stackShadow3'),
        topCardMount: document.getElementById('topCardMount'),
        sendBottomBtn: document.getElementById('sendBottomBtn'),
        checkBtn: document.getElementById('checkBtn'),
        checkBtnLabel: document.getElementById('checkBtnLabel'),
        playAgainBtn: document.getElementById('playAgainBtn'),

        errorModal: document.getElementById('errorModal'),
        errorCountNum: document.getElementById('errorCountNum'),
        errorCountWord: document.getElementById('errorCountWord'),
        errorModalText: document.getElementById('errorModalText'),
        retryAllBtn: document.getElementById('retryAllBtn'),
        showWrongHintBtn: document.getElementById('showWrongHintBtn'),

        successModal: document.getElementById('successModal'),
        attemptPill: document.getElementById('attemptPill'),
        viewSelectionBtn: document.getElementById('viewSelectionBtn'),

        teacherCodeModal: document.getElementById('teacherCodeModal'),
        teacherCodeInput: document.getElementById('teacherCodeInput'),
        teacherCodeError: document.getElementById('teacherCodeError'),
        teacherCodeConfirmBtn: document.getElementById('teacherCodeConfirmBtn'),
        teacherCodeCancelBtn: document.getElementById('teacherCodeCancelBtn'),

        solutionModal: document.getElementById('solutionModal'),
        solutionScroll: document.getElementById('solutionScroll'),
        closeSolutionBtn: document.getElementById('closeSolutionBtn'),
        solutionCloseBottomBtn: document.getElementById('solutionCloseBottomBtn'),
        solutionAutoFillBtn: document.getElementById('solutionAutoFillBtn'),

        fxCanvas: document.getElementById('fxCanvas')
      };

      /* =========================================================
         4. WEB AUDIO MINI-SOUNDS (100 % OFFLINE, STANDARD STUMM)
         ========================================================= */
      let audioCtx = null;

      function ensureAudio() {
        if (!state.soundEnabled) return null;
        if (!audioCtx) {
          const Ctx = window.AudioContext || window.webkitAudioContext;
          if (!Ctx) return null;
          audioCtx = new Ctx();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume().catch(() => {});
        }
        return audioCtx;
      }

      function playSound(type) {
        const ctx = ensureAudio();
        if (!ctx) return;
        const now = ctx.currentTime;

        if (type === 'snap') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.exponentialRampToValueAtTime(780, now + 0.065);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.085);
          osc.connect(gain).connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.09);
        } else if (type === 'skip') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(340, now);
          osc.frequency.exponentialRampToValueAtTime(220, now + 0.09);
          gain.gain.setValueAtTime(0.055, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
          osc.connect(gain).connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.11);
        } else if (type === 'error') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(290, now);
          osc.frequency.linearRampToValueAtTime(235, now + 0.18);
          gain.gain.setValueAtTime(0.075, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
          osc.connect(gain).connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.23);
        } else if (type === 'success') {
          [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            const t = now + i * 0.085;
            osc.frequency.setValueAtTime(freq, t);
            gain.gain.setValueAtTime(0.001, t);
            gain.gain.linearRampToValueAtTime(0.08, t + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, t + 0.36);
            osc.connect(gain).connect(ctx.destination);
            osc.start(t);
            osc.stop(t + 0.38);
          });
        }
      }

      /* =========================================================
         5. 60-FPS RETINA FX-CANVAS (SNAP-FUNKEN & JUBEL-KONFETTI)
         ========================================================= */
      const fx = {
        ctx: els.fxCanvas.getContext('2d'),
        particles: [],
        rafId: null,
        lastTs: 0,
        reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches
      };

      function resizeFxCanvas() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        els.fxCanvas.width = Math.round(window.innerWidth * dpr);
        els.fxCanvas.height = Math.round(window.innerHeight * dpr);
        fx.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function spawnSnapSparks(slotEl, accentColor) {
        if (fx.reducedMotion) return;
        const rect = slotEl.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const count = 9;
        for (let i = 0; i < count; i++) {
          const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.35;
          const speed = 110 + Math.random() * 120;
          fx.particles.push({
            kind: 'spark',
            x: cx + Math.cos(angle) * (rect.width * 0.24),
            y: cy + Math.sin(angle) * (rect.height * 0.24),
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            size: 3 + Math.random() * 2.5,
            color: accentColor || '#007AFF',
            life: 0,
            maxLife: 0.42 + Math.random() * 0.16
          });
        }
        startFxLoop();
      }

      function spawnCelebrationConfetti() {
        if (fx.reducedMotion) return;
        const colors = ['#007AFF', '#34C759', '#FF9500', '#AF52DE', '#FFCC00', '#2B7A68'];
        const w = window.innerWidth;
        const h = window.innerHeight;
        for (let i = 0; i < 120; i++) {
          const fromLeft = i % 2 === 0;
          const originX = fromLeft ? w * 0.24 : w * 0.76;
          const originY = h * 0.52;
          const angle = -Math.PI / 2 + (Math.random() - 0.5) * 1.45;
          const speed = 260 + Math.random() * 440;
          fx.particles.push({
            kind: 'confetti',
            x: originX + (Math.random() - 0.5) * 80,
            y: originY + (Math.random() - 0.5) * 40,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 120,
            gravity: 640 + Math.random() * 260,
            w: 6 + Math.random() * 6,
            h: 4 + Math.random() * 5,
            rot: Math.random() * Math.PI * 2,
            vRot: (Math.random() - 0.5) * 10,
            color: colors[i % colors.length],
            life: 0,
            maxLife: 1.9 + Math.random() * 1.1
          });
        }
        startFxLoop();
      }

      function startFxLoop() {
        if (fx.rafId !== null) return;
        fx.lastTs = performance.now();
        fx.rafId = requestAnimationFrame(stepFx);
      }

      function stepFx(ts) {
        if (document.hidden) {
          fx.lastTs = ts;
          fx.rafId = requestAnimationFrame(stepFx);
          return;
        }
        const dt = Math.min((ts - fx.lastTs) / 1000, 0.05);
        fx.lastTs = ts;

        const ctx = fx.ctx;
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

        for (let i = fx.particles.length - 1; i >= 0; i--) {
          const p = fx.particles[i];
          p.life += dt;
          if (p.life >= p.maxLife) {
            fx.particles.splice(i, 1);
            continue;
          }
          const alpha = 1 - p.life / p.maxLife;

          if (p.kind === 'spark') {
            p.x += p.vx * dt;
            p.y += p.vy * dt;
            p.vx *= 0.9;
            p.vy *= 0.9;
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size * (0.4 + 0.6 * alpha), 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          } else {
            p.vy += p.gravity * dt;
            p.vx *= 0.992;
            p.x += p.vx * dt;
            p.y += p.vy * dt;
            p.rot += p.vRot * dt;
            ctx.save();
            ctx.globalAlpha = Math.min(1, alpha * 1.4);
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
            ctx.restore();
          }
        }

        if (fx.particles.length > 0) {
          fx.rafId = requestAnimationFrame(stepFx);
        } else {
          ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
          fx.rafId = null;
        }
      }

      /* =========================================================
         6. EXAKT GLEICH GROSSE ZIELFELDER (normalizeSlotSizes)
         ========================================================= */
      function normalizeSlotSizes() {
        const refSlot = els.slotEls[0];
        if (!refSlot) return;
        const slotWidth = refSlot.clientWidth;
        if (!slotWidth) return;

        const measurer = els.slotMeasurer;
        measurer.style.width = `${slotWidth}px`;
        measurer.innerHTML = '';

        let maxH = 82;
        CARDS.forEach(card => {
          const probe = document.createElement('div');
          probe.style.padding = '10px 12px';
          probe.style.border = '2px solid transparent';
          probe.innerHTML = `
            <div class="placed-card-inner">
              <div class="placed-card-content">${card.html}</div>
              <span class="placed-remove-badge">×</span>
            </div>
          `;
          measurer.appendChild(probe);
          const h = Math.ceil(probe.getBoundingClientRect().height);
          if (h > maxH) maxH = h;
        });

        measurer.innerHTML = '';
        const finalH = Math.max(88, maxH + 10);
        document.documentElement.style.setProperty('--slot-h', `${finalH}px`);
      }

      /* =========================================================
         7. SPIELLOGIK: MISCHEN, ABLEGEN, NACH UNTEN, PRUEFEN
         ========================================================= */
      function shuffle(arr) {
        const copy = arr.slice();
        for (let i = copy.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
      }

      function initGame({ keepAttempts = false } = {}) {
        clearHintTimer();
        state.phase = 'playing';
        if (!keepAttempts) state.attempts = 0;

        SLOTS.forEach(s => { state.placements[s.id] = null; });
        const pool = CARDS.filter(c => state.mode === 'profi' ? true : !c.isDistractor).map(c => c.id);
        state.deck = shuffle(pool);

        closeModal(els.errorModal);
        closeModal(els.successModal);
        els.hintCountdownBar.classList.remove('is-visible');
        els.transferCard.classList.remove('is-visible');
        els.transferCard.removeAttribute('open');
        els.playAgainBtn.style.display = 'none';

        renderAll({ animateTopEnter: true });
        requestAnimationFrame(normalizeSlotSizes);
      }

      function clearHintTimer() {
        if (state.hintTimerId !== null) {
          clearInterval(state.hintTimerId);
          state.hintTimerId = null;
        }
      }

      function getFilledCount() {
        return SLOTS.reduce((acc, s) => acc + (state.placements[s.id] ? 1 : 0), 0);
      }

      function playDropEffect(slotEl, slotId) {
        const accent = SLOT_MAP[slotId]?.accent || '#007AFF';
        slotEl.classList.remove('snap-pop');
        void slotEl.offsetWidth;
        slotEl.classList.add('snap-pop');

        const ring = document.createElement('span');
        ring.className = 'slot-ripple';
        slotEl.appendChild(ring);
        setTimeout(() => ring.remove(), 540);

        spawnSnapSparks(slotEl, accent);
        playSound('snap');
      }

      function animateFlyToSlot(sourceRect, cardHtml, slotEl, onDone) {
        if (fx.reducedMotion || !sourceRect) {
          onDone();
          return;
        }
        const targetRect = slotEl.getBoundingClientRect();
        const ghost = document.createElement('div');
        ghost.className = 'drag-ghost';
        ghost.innerHTML = cardHtml;
        ghost.style.width = `${sourceRect.width}px`;
        ghost.style.transform = `translate3d(${sourceRect.left}px, ${sourceRect.top}px, 0) scale(1)`;
        ghost.style.transition = 'transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease';
        document.body.appendChild(ghost);

        requestAnimationFrame(() => {
          const dx = targetRect.left + (targetRect.width - sourceRect.width) / 2;
          const dy = targetRect.top + (targetRect.height - sourceRect.height) / 2;
          const scaleX = Math.min(1.02, targetRect.width / Math.max(sourceRect.width, 1));
          ghost.style.transform = `translate3d(${dx}px, ${dy}px, 0) scale(${scaleX})`;
          ghost.style.opacity = '0.88';
        });

        setTimeout(() => {
          ghost.remove();
          onDone();
        }, 235);
      }

      function placeTopCardInSlot(slotId, { fromDrag = false } = {}) {
        if (state.phase !== 'playing') return;
        if (state.placements[slotId] !== null) return;
        if (state.deck.length === 0) return;

        const cardId = state.deck[0];
        const card = CARD_MAP[cardId];
        const slotEl = document.querySelector(`.drop-slot[data-slot-id="${slotId}"]`);
        const topCardEl = els.topCardMount.querySelector('.top-card');
        const sourceRect = (!fromDrag && topCardEl) ? topCardEl.getBoundingClientRect() : null;

        state.deck.shift();
        state.placements[slotId] = cardId;

        if (fromDrag || !sourceRect || fx.reducedMotion) {
          renderAll({ animateTopEnter: true });
          if (slotEl) playDropEffect(slotEl, slotId);
        } else {
          renderDeck({ animateTopEnter: true });
          animateFlyToSlot(sourceRect, card.html, slotEl, () => {
            renderSlots();
            updateProgressAndButtons();
            if (slotEl) playDropEffect(slotEl, slotId);
          });
        }
      }

      function returnSlotCardToDeck(slotId) {
        if (state.phase !== 'playing') return;
        const cardId = state.placements[slotId];
        if (!cardId) return;
        state.placements[slotId] = null;
        state.deck.unshift(cardId);
        playSound('skip');
        renderAll({ animateTopEnter: true });
      }

      function movePlacedCard(fromSlotId, toSlotId) {
        if (state.phase !== 'playing' || fromSlotId === toSlotId) return;
        const fromCard = state.placements[fromSlotId];
        if (!fromCard) return;
        const toCard = state.placements[toSlotId];
        state.placements[toSlotId] = fromCard;
        state.placements[fromSlotId] = toCard; // tauscht oder leert Ursprungsfeld
        renderAll({ animateTopEnter: false });
        const targetEl = document.querySelector(`.drop-slot[data-slot-id="${toSlotId}"]`);
        if (targetEl) playDropEffect(targetEl, toSlotId);
      }

      function sendTopCardToBottom() {
        if (state.phase !== 'playing' || state.deck.length <= 1) return;
        const topCardEl = els.topCardMount.querySelector('.top-card');
        playSound('skip');

        const finishSkip = () => {
          state.deck.push(state.deck.shift());
          renderDeck({ animateTopEnter: true });
        };

        if (topCardEl && !fx.reducedMotion) {
          topCardEl.classList.add('anim-skip');
          setTimeout(finishSkip, 220);
        } else {
          finishSkip();
        }
      }

      /* =========================================================
         8. UEBERPRUEFUNG, JUBEL, FEHLER-MODAL & 3-SEK.-HILFE
         ========================================================= */
      function checkSolution() {
        if (state.phase !== 'playing') return;
        if (getFilledCount() !== SLOTS.length) return;

        const wrongSlotIds = [];
        SLOTS.forEach(s => {
          const placedCardId = state.placements[s.id];
          const card = CARD_MAP[placedCardId];
          if (!card || card.targetSlot !== s.id) {
            wrongSlotIds.push(s.id);
          }
        });

        const errorCount = wrongSlotIds.length;

        if (errorCount === 0) {
          const solvedAttempt = state.attempts + 1;
          state.phase = 'review-success';
          renderAll({ animateTopEnter: false });
          els.transferCard.classList.add('is-visible');
          els.playAgainBtn.style.display = 'inline-flex';

          els.attemptPill.textContent = solvedAttempt === 1
            ? 'Gelöst im 1. Versuch'
            : `Stark durchgehalten – gelöst im ${solvedAttempt}. Versuch`;

          spawnCelebrationConfetti();
          playSound('success');
          openModal(els.successModal);
        } else {
          state.attempts += 1;
          state.phase = 'error-modal';
          playSound('error');

          els.errorCountNum.textContent = String(errorCount);
          els.errorCountWord.textContent = errorCount === 1 ? 'Fehler' : 'Fehler';
          els.errorModalText.textContent = errorCount === 1
            ? 'Es steckt nur noch 1 Fehler im Ablaufschema. Schau dir die Vorlage noch einmal kurz an und ordne alles neu zu.'
            : `Noch ${errorCount} Felder passen nicht zur Vorlage. Achte auf die Verzweigung bei Schritt 2 sowie auf Vorzeichen und Gegenprobe – und starte sauber neu.`;

          // Ab dem 3. Fehlversuch: sanfte 3-Sekunden-Hilfe anbieten
          els.showWrongHintBtn.style.display = state.attempts >= 3 ? 'inline-flex' : 'none';
          els.showWrongHintBtn.dataset.wrongIds = wrongSlotIds.join(',');

          openModal(els.errorModal);
        }
      }

      function triggerThreeSecondHint() {
        const wrongIds = (els.showWrongHintBtn.dataset.wrongIds || '').split(',').filter(Boolean);
        closeModal(els.errorModal);
        state.phase = 'hint-flash';

        els.slotEls.forEach(slotEl => {
          const id = slotEl.dataset.slotId;
          slotEl.classList.toggle('is-wrong-hint', wrongIds.includes(id));
          slotEl.classList.add('is-locked');
        });

        let secLeft = 3;
        els.hintCountdownPill.textContent = `${secLeft} s`;
        els.hintCountdownBar.classList.add('is-visible');

        clearHintTimer();
        state.hintTimerId = setInterval(() => {
          secLeft -= 1;
          if (secLeft > 0) {
            els.hintCountdownPill.textContent = `${secLeft} s`;
          } else {
            clearHintTimer();
            initGame({ keepAttempts: true });
          }
        }, 1000);
      }

      /* =========================================================
         9. RENDERING
         ========================================================= */
      function renderAll({ animateTopEnter = false } = {}) {
        renderSlots();
        renderDeck({ animateTopEnter });
        updateProgressAndButtons();
      }

      function renderSlots() {
        const locked = state.phase !== 'playing';
        els.slotEls.forEach(slotEl => {
          const slotId = slotEl.dataset.slotId;
          const cardId = state.placements[slotId];
          slotEl.classList.remove('is-drag-over', 'is-wrong-hint');
          slotEl.classList.toggle('is-locked', locked);
          slotEl.classList.toggle('is-filled', Boolean(cardId));
          slotEl.classList.toggle('is-success', state.phase === 'review-success');

          if (cardId) {
            const card = CARD_MAP[cardId];
            slotEl.innerHTML = `
              <div class="placed-card-inner">
                <div class="placed-card-content">${card.html}</div>
                <span class="placed-remove-badge" title="${state.phase === 'review-success' ? 'Richtig zugeordnet' : 'Antippen zum Zurücklegen'}">${state.phase === 'review-success' ? '✓' : '↩'}</span>
              </div>
            `;
          } else {
            slotEl.innerHTML = `
              <div class="slot-placeholder">
                <span class="slot-placeholder-icon">+</span>
                <span>Hier ablegen</span>
              </div>
            `;
          }
        });
      }

      function renderDeck({ animateTopEnter = false } = {}) {
        const count = state.deck.length;
        const filledCount = getFilledCount();
        const allFilled = filledCount === SLOTS.length;

        els.profiNotice.classList.toggle('is-visible', state.mode === 'profi');

        if (state.phase === 'review-success') {
          els.deckCounterPill.textContent = 'Alle 7 gelöst';
          els.deckCounterPill.classList.add('is-done');
        } else if (allFilled && state.mode === 'profi') {
          els.deckCounterPill.textContent = `${count} Ablenker übrig`;
          els.deckCounterPill.classList.add('is-done');
        } else {
          els.deckCounterPill.textContent = count === 1 ? '1 Karte' : `${count} Karten`;
          els.deckCounterPill.classList.toggle('is-done', count === 0);
        }

        els.stackShadow2.classList.toggle('is-hidden', count < 2 || state.phase === 'review-success');
        els.stackShadow3.classList.toggle('is-hidden', count < 3 || state.phase === 'review-success');

        if (state.phase === 'review-success') {
          els.topCardMount.innerHTML = `
            <div class="stack-empty-box">
              <div class="stack-empty-title">Stark gelöst!</div>
              <div class="stack-empty-sub">Deine fertige Auswahl bleibt links unverändert sichtbar.</div>
            </div>
          `;
          return;
        }

        if (count === 0) {
          els.topCardMount.innerHTML = `
            <div class="stack-empty-box">
              <div class="stack-empty-title">Alle Felder sind belegt</div>
              <div class="stack-empty-sub">Klicke jetzt auf „Jetzt überprüfen“ oder tippe eine Karte zum Umordnen an.</div>
            </div>
          `;
          return;
        }

        const topCard = CARD_MAP[state.deck[0]];
        const tipText = allFilled
          ? 'Alle 7 Felder sind voll. Im Profi-Modus bleiben 2 Ablenker-Karten übrig.'
          : 'Ziehen oder ein freies Feld antippen';

        els.topCardMount.innerHTML = `
          <div class="top-card ${animateTopEnter ? 'anim-enter' : ''}" data-card-id="${topCard.id}">
            <div class="top-card-kicker">
              <span>Oberste Karte</span>
              <span class="drag-grip">☰ Ziehen / Tippen</span>
            </div>
            <div class="top-card-body">${topCard.html}</div>
            <div class="top-card-tip">${tipText}</div>
          </div>
        `;

        const newTopCard = els.topCardMount.querySelector('.top-card');
        if (newTopCard) {
          attachDeckDrag(newTopCard);
        }
      }

      function updateProgressAndButtons() {
        const filled = getFilledCount();
        const total = SLOTS.length;
        const remaining = total - filled;
        const allFilled = remaining === 0;

        els.progressRatio.textContent = `${filled} / ${total}`;
        els.progressFill.style.width = `${(filled / total) * 100}%`;
        els.progressFill.classList.toggle('is-complete', allFilled);

        if (state.phase === 'review-success') {
          els.progressLabel.textContent = 'Alle 7 Felder richtig zugeordnet';
        } else if (allFilled) {
          els.progressLabel.textContent = 'Bereit zur Überprüfung';
        } else {
          els.progressLabel.textContent = remaining === 1 ? 'Noch 1 freies Feld' : `Noch ${remaining} freie Felder`;
        }

        const canSkip = state.phase === 'playing' && state.deck.length > 1;
        els.sendBottomBtn.disabled = !canSkip;
        els.sendBottomBtn.style.display = state.phase === 'review-success' ? 'none' : 'inline-flex';

        const canCheck = state.phase === 'playing' && allFilled;
        els.checkBtn.disabled = !canCheck;
        els.checkBtn.setAttribute('aria-disabled', String(!canCheck));
        els.checkBtn.style.display = state.phase === 'review-success' ? 'none' : 'inline-flex';
        els.checkBtnLabel.textContent = allFilled ? 'Jetzt überprüfen' : `Erst alle ${total} Felder füllen`;
      }

      /* =========================================================
         10. POINTER-EVENTS DRAG-AND-DROP (60 FPS, MAUS & TOUCH)
         ========================================================= */
      let dragSession = null;
      let suppressSlotClickUntil = 0;

      function findSlotAtPoint(x, y) {
        for (const slotEl of els.slotEls) {
          const r = slotEl.getBoundingClientRect();
          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) {
            return slotEl;
          }
        }
        return null;
      }

      function startPointerDrag(e, { sourceType, cardId, fromSlotId, sourceEl }) {
        if (state.phase !== 'playing') return;
        if (e.button !== undefined && e.button !== 0) return;

        const rect = sourceEl.getBoundingClientRect();
        dragSession = {
          pointerId: e.pointerId,
          sourceType,
          cardId,
          fromSlotId,
          sourceEl,
          startX: e.clientX,
          startY: e.clientY,
          offsetX: e.clientX - rect.left,
          offsetY: e.clientY - rect.top,
          width: Math.min(rect.width, 320),
          moved: false,
          ghost: null,
          hoveredSlot: null
        };

        try { sourceEl.setPointerCapture(e.pointerId); } catch (_) {}
      }

      function onPointerMoveDrag(e) {
        if (!dragSession || e.pointerId !== dragSession.pointerId) return;
        const dx = e.clientX - dragSession.startX;
        const dy = e.clientY - dragSession.startY;

        if (!dragSession.moved && Math.hypot(dx, dy) > 7) {
          dragSession.moved = true;
          const ghost = document.createElement('div');
          ghost.className = 'drag-ghost';
          ghost.style.width = `${dragSession.width}px`;
          ghost.innerHTML = CARD_MAP[dragSession.cardId].html;
          document.body.appendChild(ghost);
          dragSession.ghost = ghost;
          dragSession.sourceEl.classList.add('is-dragging-source');
        }

        if (dragSession.moved && dragSession.ghost) {
          const x = e.clientX - dragSession.offsetX;
          const y = e.clientY - dragSession.offsetY;
          dragSession.ghost.style.transform = `translate3d(${x}px, ${y}px, 0) scale(1.03)`;

          const hit = findSlotAtPoint(e.clientX, e.clientY);
          const canAccept = hit && (
            dragSession.sourceType === 'slot' ||
            state.placements[hit.dataset.slotId] === null
          );

          if (dragSession.hoveredSlot && dragSession.hoveredSlot !== hit) {
            dragSession.hoveredSlot.classList.remove('is-drag-over');
          }
          if (canAccept) {
            hit.classList.add('is-drag-over');
            dragSession.hoveredSlot = hit;
          } else {
            dragSession.hoveredSlot = null;
          }
        }
      }

      function onPointerEndDrag(e) {
        if (!dragSession || e.pointerId !== dragSession.pointerId) return;
        const session = dragSession;
        dragSession = null;

        if (session.ghost) session.ghost.remove();
        session.sourceEl.classList.remove('is-dragging-source');
        els.slotEls.forEach(s => s.classList.remove('is-drag-over'));

        if (!session.moved) {
          // Kurzer Tap auf bereits belegtes Feld -> zurueck auf den Stapel
          if (session.sourceType === 'slot') {
            suppressSlotClickUntil = performance.now() + 350;
            returnSlotCardToDeck(session.fromSlotId);
          }
          return;
        }

        const hit = findSlotAtPoint(e.clientX, e.clientY);
        if (hit) {
          const targetSlotId = hit.dataset.slotId;
          if (session.sourceType === 'deck' && state.placements[targetSlotId] === null) {
            placeTopCardInSlot(targetSlotId, { fromDrag: true });
          } else if (session.sourceType === 'slot') {
            suppressSlotClickUntil = performance.now() + 250;
            movePlacedCard(session.fromSlotId, targetSlotId);
          }
        } else if (session.sourceType === 'slot') {
          // Karte aus Feld herausgezogen -> zurueck oben auf Stapel
          suppressSlotClickUntil = performance.now() + 250;
          returnSlotCardToDeck(session.fromSlotId);
        }
      }

      function attachDeckDrag(cardEl) {
        cardEl.addEventListener('pointerdown', e => {
          if (state.deck.length === 0) return;
          startPointerDrag(e, {
            sourceType: 'deck',
            cardId: state.deck[0],
            fromSlotId: null,
            sourceEl: cardEl
          });
        });
      }

      /* =========================================================
         11. MODALS, LUPE & LEHRKRAFT-MODUS (MASTERCODE 86)
         ========================================================= */
      function openModal(backdropEl) {
        backdropEl.classList.add('is-open');
      }

      function closeModal(backdropEl) {
        backdropEl.classList.remove('is-open');
      }

      function openZoomOverlay() {
        els.zoomCanvasInner.innerHTML = els.templateSvg.outerHTML;
        setZoomScale(100);
        openModal(els.zoomModal);
      }

      function setZoomScale(percent) {
        els.zoomCanvasInner.style.width = `${percent}%`;
        document.querySelectorAll('[data-zoom]').forEach(btn => {
          btn.classList.toggle('is-active', Number(btn.dataset.zoom) === percent);
        });
      }

      function renderTeacherSolutionModal() {
        const rows = SLOTS.map(s => {
          const card = CARDS.find(c => c.targetSlot === s.id);
          return `
            <div class="solution-row" style="border-left-color:${s.accent};">
              <div class="solution-row-head">Schritt ${s.code} · ${s.title}</div>
              <div>${card.html}</div>
            </div>
          `;
        });

        const distractors = CARDS.filter(c => c.isDistractor).map((d, idx) => `
          <div class="solution-row is-distractor">
            <div class="solution-row-head">Profi-Ablenker ${idx + 1} (bleibt übrig!)</div>
            <div>${d.html}</div>
            <div style="margin-top:5px;font-size:12.5px;color:var(--ios-red-text);font-weight:600;">${d.distractorReason}</div>
          </div>
        `);

        els.solutionScroll.innerHTML = rows.join('') + distractors.join('');
      }

      function autoFillTeacherSolution() {
        clearHintTimer();
        closeModal(els.solutionModal);
        closeModal(els.errorModal);
        closeModal(els.successModal);
        SLOTS.forEach(s => {
          const card = CARDS.find(c => c.targetSlot === s.id);
          state.placements[s.id] = card.id;
        });
        state.deck = state.mode === 'profi' ? CARDS.filter(c => c.isDistractor).map(c => c.id) : [];
        state.phase = 'review-success';
        els.transferCard.classList.add('is-visible');
        els.playAgainBtn.style.display = 'inline-flex';
        renderAll({ animateTopEnter: false });
      }

      /* =========================================================
         12. EVENT-LISTENER VERBINDEN
         ========================================================= */
      window.addEventListener('pointermove', onPointerMoveDrag);
      window.addEventListener('pointerup', onPointerEndDrag);
      window.addEventListener('pointercancel', onPointerEndDrag);

      els.slotEls.forEach(slotEl => {
        const slotId = slotEl.dataset.slotId;

        slotEl.addEventListener('pointerdown', e => {
          if (state.phase !== 'playing') return;
          if (state.placements[slotId] !== null) {
            startPointerDrag(e, {
              sourceType: 'slot',
              cardId: state.placements[slotId],
              fromSlotId: slotId,
              sourceEl: slotEl
            });
          }
        });

        slotEl.addEventListener('click', () => {
          if (state.phase !== 'playing') return;
          if (performance.now() < suppressSlotClickUntil) return;
          if (state.placements[slotId] === null) {
            placeTopCardInSlot(slotId, { fromDrag: false });
          }
        });

        slotEl.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            if (state.phase !== 'playing') return;
            if (state.placements[slotId] === null) {
              placeTopCardInSlot(slotId, { fromDrag: false });
            } else {
              returnSlotCardToDeck(slotId);
            }
          }
        });
      });

      els.sendBottomBtn.addEventListener('click', sendTopCardToBottom);
      els.checkBtn.addEventListener('click', checkSolution);
      els.playAgainBtn.addEventListener('click', () => initGame({ keepAttempts: false }));
      els.resetBtn.addEventListener('click', () => initGame({ keepAttempts: false }));

      // Modus-Umschalter (Standard | Profi)
      els.modeStandardBtn.addEventListener('click', () => {
        if (state.mode === 'standard') return;
        state.mode = 'standard';
        els.modeStandardBtn.setAttribute('aria-pressed', 'true');
        els.modeProfiBtn.setAttribute('aria-pressed', 'false');
        initGame({ keepAttempts: false });
      });

      els.modeProfiBtn.addEventListener('click', () => {
        if (state.mode === 'profi') return;
        state.mode = 'profi';
        els.modeStandardBtn.setAttribute('aria-pressed', 'false');
        els.modeProfiBtn.setAttribute('aria-pressed', 'true');
        initGame({ keepAttempts: false });
      });

      // Ton-Umschalter (Standard stumm)
      els.soundToggleBtn.addEventListener('click', () => {
        state.soundEnabled = !state.soundEnabled;
        els.soundToggleBtn.setAttribute('aria-pressed', String(state.soundEnabled));
        els.soundToggleBtn.classList.toggle('is-active', state.soundEnabled);
        els.soundIcon.textContent = state.soundEnabled ? '🔊' : '🔇';
        els.soundLabel.textContent = state.soundEnabled ? 'Ton an' : 'Ton aus';
        if (state.soundEnabled) playSound('snap');
      });

      // Fehler- & Erfolgs-Modals
      els.retryAllBtn.addEventListener('click', () => initGame({ keepAttempts: true }));
      els.showWrongHintBtn.addEventListener('click', triggerThreeSecondHint);
      els.viewSelectionBtn.addEventListener('click', () => closeModal(els.successModal));

      // Vorlagen-Lupe
      els.openZoomBtn.addEventListener('click', openZoomOverlay);
      els.visualStageTrigger.addEventListener('click', openZoomOverlay);
      els.visualStageTrigger.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openZoomOverlay(); }
      });
      els.closeZoomBtn.addEventListener('click', () => closeModal(els.zoomModal));
      els.zoomModal.addEventListener('click', e => {
        if (e.target === els.zoomModal) closeModal(els.zoomModal);
      });
      document.querySelectorAll('[data-zoom]').forEach(btn => {
        btn.addEventListener('click', () => setZoomScale(Number(btn.dataset.zoom)));
      });

      // Lehrkraft-Modus (Mastercode 86)
      els.teacherBtn.addEventListener('click', () => {
        if (state.teacherMode) {
          renderTeacherSolutionModal();
          openModal(els.solutionModal);
        } else {
          els.teacherCodeInput.value = '';
          els.teacherCodeError.textContent = '';
          openModal(els.teacherCodeModal);
          setTimeout(() => els.teacherCodeInput.focus(), 60);
        }
      });

      function verifyTeacherCode() {
        if (els.teacherCodeInput.value.trim() === '86') {
          state.teacherMode = true;
          closeModal(els.teacherCodeModal);
          els.teacherBtn.classList.add('is-teacher');
          els.teacherBtnLabel.textContent = 'Lehrkraft aktiv';
          els.teacherBar.classList.add('is-visible');
          renderTeacherSolutionModal();
          openModal(els.solutionModal);
        } else {
          els.teacherCodeError.textContent = 'Code nicht korrekt.';
          els.teacherCodeInput.select();
        }
      }

      els.teacherCodeConfirmBtn.addEventListener('click', verifyTeacherCode);
      els.teacherCodeInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') verifyTeacherCode();
      });
      els.teacherCodeCancelBtn.addEventListener('click', () => closeModal(els.teacherCodeModal));
      els.showSolutionModalBtn.addEventListener('click', () => {
        renderTeacherSolutionModal();
        openModal(els.solutionModal);
      });
      els.autoFillBtn.addEventListener('click', autoFillTeacherSolution);
      els.solutionAutoFillBtn.addEventListener('click', autoFillTeacherSolution);
      els.closeSolutionBtn.addEventListener('click', () => closeModal(els.solutionModal));
      els.solutionCloseBottomBtn.addEventListener('click', () => closeModal(els.solutionModal));
      els.exitTeacherBtn.addEventListener('click', () => {
        state.teacherMode = false;
        els.teacherBtn.classList.remove('is-teacher');
        els.teacherBtnLabel.textContent = 'Lehrkraft';
        els.teacherBar.classList.remove('is-visible');
        initGame({ keepAttempts: false });
      });

      // Escape schliesst Info-Modals (nicht das verpflichtende Fehler-Modal)
      window.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          closeModal(els.zoomModal);
          closeModal(els.teacherCodeModal);
          closeModal(els.solutionModal);
          if (state.phase === 'review-success') closeModal(els.successModal);
        }
      });

      // Resize & Slot-Groessen-Normalisierung
      let resizeTimer = null;
      window.addEventListener('resize', () => {
        resizeFxCanvas();
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(normalizeSlotSizes, 80);
      });

      if ('ResizeObserver' in window && els.slotEls[0]) {
        const ro = new ResizeObserver(() => normalizeSlotSizes());
        ro.observe(els.slotEls[0]);
      }

      /* =========================================================
         13. START
         ========================================================= */
      resizeFxCanvas();
      initGame({ keepAttempts: false });
    })();
  </script>
</body>
</html>
